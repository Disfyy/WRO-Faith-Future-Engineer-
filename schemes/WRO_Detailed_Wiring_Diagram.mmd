flowchart LR

  %% Styles
  classDef power fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000;
  classDef gnd fill:#e0e0e0,stroke:#37474f,stroke-width:2px,color:#000;
  classDef signal fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000;
  classDef sensor fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000;
  classDef brains fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000;
  classDef star fill:#000000,color:#ffffff,shape:circle,stroke-width:4px,stroke:#ffeb3b;

  subgraph PWR [1. Power Supply]
    direction TB
    BATT[LiPo 2S or 3S]:::power
    SW[KCD3 Main Switch]:::power
    V5[+5V Rail]:::power

    STAR_PWR(((STAR GND))):::star

    BATT -- "+VBAT" --> SW
    BATT -- "GND -" --> STAR_PWR
    SW -- "+VBAT" --> V5
    STAR_PWR -- "GND -" --> V5

    C470[470uF Cap]:::gnd
    C104_5[0.1uF 5V]:::gnd
    V5 -. "Filter" .- C470
    V5 -. "Filter" .- C104_5
  end

  subgraph BRAIN [2. Controllers]
    direction TB
    ESP[ESP32-S3-DevKitC-1 N8R8]:::brains
    OMV[OpenMV H7 Plus]:::brains
    ESTOP[E-STOP GPIO21]:::signal
    LED[Status LED GPIO2]:::signal
    RGB[Onboard WS2812 GPIO48]:::signal

    STAR_BRAIN(((STAR GND))):::star

    V5 -- "5V -> VIN" --> ESP
    STAR_BRAIN -- "GND" --> ESP

    V5 -- "5V -> VIN" --> OMV
    STAR_BRAIN -- "GND" --> OMV

    ESP -- "UART2 GPIO17 RX <- TX" --> OMV
    ESP -- "UART2 GPIO18 TX -> RX" --> OMV

    ESP -- "GPIO21" --> ESTOP
    STAR_BRAIN -- "GND" --> ESTOP

    ESP -- "GPIO2 (Anode)" --> LED
    STAR_BRAIN -- "Cathode" --> LED
    ESP -- "GPIO48" --> RGB
  end

  subgraph DRIVE [3. Motor and Servo]
    direction TB
    BTS[BTS7960 Driver]:::signal
    MOT[Motor 380]:::power
    SRV[JX PDI-6221MG]:::signal

    STAR_DRIVE(((STAR GND))):::star

    SW -- "+VBAT -> B+" --> BTS
    STAR_DRIVE -- "GND -> B-" --> BTS
    V5 -- "+5V -> VCC" --> BTS
    STAR_DRIVE -- "Logic GND" --> BTS

    ESP -- "GPIO38/39 (EN)" --> BTS
    ESP -- "GPIO40/41 (PWM)" --> BTS
    BTS -- "M+" --> MOT
    BTS -- "M-" --> MOT

    V5 -- "+5V (Red)" --> SRV
    STAR_DRIVE -- "GND (Brown)" --> SRV
    ESP -- "GPIO42 (Orange)" --> SRV

    CM[3x 0.1uF Motor Filter]:::gnd
    MOT -. "Noise Filter" .- CM
  end

  subgraph I2CBUS [4. I2C - IMU only]
    direction TB
    IMU[ICM-20948 @ 0x68]:::sensor
    PULLUP[4.7k Pull-ups]:::gnd

    STAR_I2C(((STAR GND))):::star

    ESP -- "+3.3V (onboard reg)" --> PULLUP
    ESP -- "GPIO8 SDA, GPIO9 SCL" --> PULLUP
    PULLUP -- "SDA, SCL" --> IMU

    ESP -- "+3.3V -> VCC, AD0->GND" --> IMU
    STAR_I2C -- "GND" --> IMU
  end

  subgraph SPIBUS [5. SPI HSPI - 2x AS5048A 14-bit]
    direction TB
    ASL[AS5048A Left CS=GPIO10]:::sensor
    ASR[AS5048A Right CS=GPIO14]:::sensor

    STAR_SPI(((STAR GND))):::star

    ESP -- "GPIO11 MOSI tied to 3V3" --> ASL
    ESP -- "GPIO12 SCK" --> ASL
    ESP -- "GPIO13 MISO" --> ASL
    ESP -- "GPIO10 CS" --> ASL
    ESP -- "+3.3V" --> ASL
    STAR_SPI -- "GND" --> ASL

    ESP -- "shared MOSI/SCK/MISO" --> ASR
    ESP -- "GPIO14 CS" --> ASR
    ESP -- "+3.3V" --> ASR
    STAR_SPI -- "GND" --> ASR
  end

  subgraph UARTBLK [6. UART distance and camera]
    direction TB
    TFF[TFMini-S Front 12m]:::sensor
    TFS[TFMini-S Side optional]:::sensor

    STAR_UART(((STAR GND))):::star

    V5 -- "+5V REQUIRED" --> TFF
    STAR_UART -- "GND" --> TFF
    ESP -- "UART1 GPIO15 RX <- TX" --> TFF
    ESP -- "UART1 GPIO16 TX -> RX" --> TFF

    V5 -. "+5V if wired" .-> TFS
    STAR_UART -. "GND if wired" .-> TFS
    ESP -. "UART SW GPIO47 RX" .-> TFS
  end

  %% Connect the Star Grounds (single physical point)
  STAR_PWR ===|ALL STAR GROUNDS CONNECT TO ONE POINT| STAR_BRAIN
  STAR_BRAIN === STAR_DRIVE
  STAR_DRIVE === STAR_I2C
  STAR_I2C === STAR_SPI
  STAR_SPI === STAR_UART
