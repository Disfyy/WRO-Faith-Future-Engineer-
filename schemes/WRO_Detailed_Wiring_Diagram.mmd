flowchart LR

  %% Styles
  classDef power fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000;
  classDef gnd fill:#e0e0e0,stroke:#37474f,stroke-width:2px,color:#000;
  classDef signal fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000;
  classDef sensor fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000;
  classDef brains fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000;
  classDef star fill:#000000,color:#ffffff,shape:circle,stroke-width:4px,stroke:#ffeb3b;

  subgraph PWR [1. Power Supply]
    direction TB
    BATT[LiPo 2S or 3S]:::power
    SW[KCD3 Main Switch]:::power
    V5[+5V Rail]:::power

    STAR_PWR(((STAR GND))):::star

    BATT -- "+VBAT" --> SW
    BATT -- "GND -" --> STAR_PWR
    SW -- "+VBAT" --> V5
    STAR_PWR -- "GND -" --> V5

    C470[470uF Cap]:::gnd
    C104_5[0.1uF 5V]:::gnd
    V5 -. "Filter" .- C470
    V5 -. "Filter" .- C104_5
  end

  subgraph BRAIN [2. Controllers]
    direction TB
    ESP[ESP32-S3-DevKitC-1 N8R8]:::brains
    OMV[OpenMV H7 Plus]:::brains
    ESTOP[E-STOP GPIO21]:::signal
    LED[Status LED GPIO2]:::signal
    RGB[Onboard WS2812 GPIO48]:::signal

    STAR_BRAIN(((STAR GND))):::star

    V5 -- "5V -> VIN" --> ESP
    STAR_BRAIN -- "GND" --> ESP

    V5 -- "5V -> VIN" --> OMV
    STAR_BRAIN -- "GND" --> OMV

    ESP -- "UART2 GPIO17 RX <- TX" --> OMV
    ESP -- "UART2 GPIO18 TX -> RX" --> OMV

    ESP -- "GPIO21" --> ESTOP
    STAR_BRAIN -- "GND" --> ESTOP

    ESP -- "GPIO2 (Anode)" --> LED
    STAR_BRAIN -- "Cathode" --> LED
    ESP -- "GPIO48" --> RGB
  end

  subgraph DRIVE [3. Motor and Servo]
    direction TB
    BTS[BTS7960 Driver]:::signal
    MOT[Motor 380]:::power
    SRV[JX PDI-6221MG]:::signal

    STAR_DRIVE(((STAR GND))):::star

    SW -- "+VBAT -> B+" --> BTS
    STAR_DRIVE -- "GND -> B-" --> BTS
    V5 -- "+5V -> VCC" --> BTS
    STAR_DRIVE -- "Logic GND" --> BTS

    ESP -- "GPIO38/39 (EN)" --> BTS
    ESP -- "GPIO40/41 (PWM)" --> BTS
    BTS -- "M+" --> MOT
    BTS -- "M-" --> MOT

    V5 -- "+5V (Red)" --> SRV
    STAR_DRIVE -- "GND (Brown)" --> SRV
    ESP -- "GPIO42 (Orange)" --> SRV

    CM[3x 0.1uF Motor Filter]:::gnd
    MOT -. "Noise Filter" .- CM
  end

  subgraph I2C0 [4. I2C0 Wire - IMU + AS5600 L + VL53L1X Front]
    direction TB
    IMU[ICM-20948 @ 0x68]:::sensor
    AS5600L[AS5600 Left @ 0x36]:::sensor
    TFFR[VL53L1X Front 0x29 -> 0x30]:::sensor
    PULL0[4.7k Pull-ups]:::gnd

    STAR_I2C0(((STAR GND))):::star

    ESP -- "+3.3V onboard reg" --> PULL0
    ESP -- "GPIO8 SDA, GPIO9 SCL" --> PULL0
    PULL0 -- "SDA, SCL" --> IMU
    PULL0 -- "SDA, SCL" --> AS5600L
    PULL0 -- "SDA, SCL" --> TFFR

    ESP -- "+3.3V VCC, AD0->GND" --> IMU
    ESP -- "+3.3V VCC" --> AS5600L
    V5  -- "+5V VIN" --> TFFR
    ESP -- "GPIO15 XSHUT (HIGH after boot remap)" --> TFFR

    STAR_I2C0 -- "GND" --> IMU
    STAR_I2C0 -- "GND" --> AS5600L
    STAR_I2C0 -- "GND" --> TFFR
  end

  subgraph I2C1 [5. I2C1 Wire1 - AS5600 R + VL53L1X Side]
    direction TB
    AS5600R[AS5600 Right @ 0x36]:::sensor
    TFSD[VL53L1X Side 0x29 -> 0x31]:::sensor
    PULL1[4.7k Pull-ups]:::gnd

    STAR_I2C1(((STAR GND))):::star

    ESP -- "+3.3V onboard reg" --> PULL1
    ESP -- "GPIO11 SDA, GPIO12 SCL" --> PULL1
    PULL1 -- "SDA, SCL" --> AS5600R
    PULL1 -- "SDA, SCL" --> TFSD

    ESP -- "+3.3V VCC" --> AS5600R
    V5  -- "+5V VIN" --> TFSD
    ESP -- "GPIO16 XSHUT (HIGH after boot remap)" --> TFSD

    STAR_I2C1 -- "GND" --> AS5600R
    STAR_I2C1 -- "GND" --> TFSD
  end

  %% Connect the Star Grounds (single physical point)
  STAR_PWR ===|ALL STAR GROUNDS CONNECT TO ONE POINT| STAR_BRAIN
  STAR_BRAIN === STAR_DRIVE
  STAR_DRIVE === STAR_I2C0
  STAR_I2C0 === STAR_I2C1
