%% WRO v13 — Detailed wiring diagram
%% Per-wire detail: rail voltage, GPIO, decoupling, every return to star ground.
%% Companion: WRO_Full_System_Diagram.mmd (higher-level overview).

flowchart TB

  classDef brain  fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000
  classDef cam    fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#000
  classDef act    fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#000
  classDef sens   fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
  classDef pwr5   fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000
  classDef pwr3   fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
  classDef pass   fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#000
  classDef io     fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
  classDef star   fill:#212121,color:#ffeb3b,stroke:#ffeb3b,stroke-width:4px

  %% ===== POWER SUPPLY =====
  subgraph PWR ["1 · Power supply"]
    direction LR
    BATT["LiPo 2S/3S<br/>7.4–11.1 V<br/>≥35 C, ≥1.5 Ah"]:::pwr5
    SW["KCD3 main switch"]:::pwr5
    VBATT(["+VBAT bus"]):::pwr5
    BUCK["LM2596 / D-SUN buck<br/>Vin → 5 V · 3 A"]:::pwr5
    V5(["+5 V rail"]):::pwr5
    C470["470 µF / 16 V<br/>(bulk @ V5)"]:::pass
    C104_5["0.1 µF<br/>(HF @ V5)"]:::pass
    BATT -- "+ red" --> SW
    SW -- "+VBAT" --> VBATT
    VBATT -- "VIN" --> BUCK
    BUCK -- "+5 V" --> V5
    V5 --- C470
    V5 --- C104_5
  end

  %% ===== CONTROLLERS =====
  subgraph BRAIN ["2 · Controllers"]
    direction TB
    ESP["<b>ESP32-S3-DevKitC-1</b><br/>N8R8 · 8 MB flash + 8 MB PSRAM<br/>3.3 V from onboard LDO"]:::brain
    OMV["<b>OpenMV H7 Plus</b><br/>vision · UART2 @ 115200"]:::cam
    ESTOP["E-STOP<br/>GPIO 21 · INPUT_PULLUP<br/>HW interrupt → SAFE_STOP"]:::io
    LED["Status LED<br/>GPIO 2 · 220 Ω series"]:::io
    RGB["WS2812 onboard<br/>GPIO 48"]:::io
  end

  V5 -- "+5 V → VIN" --> ESP
  V5 -- "+5 V → VIN" --> OMV
  ESP -- "UART2 RX  GPIO 17  ← TX" --- OMV
  ESP -- "UART2 TX  GPIO 18  → RX" --- OMV
  ESP -- "GPIO 21" --- ESTOP
  ESP -- "GPIO 2 (anode)" --- LED
  ESP -- "GPIO 48" --- RGB

  %% ===== ACTUATORS =====
  subgraph ACT ["3 · Drive and steering"]
    direction TB
    BTS["BTS7960<br/>43 A H-Bridge"]:::act
    MOT["Motor 380<br/>brushed DC"]:::act
    SRV["JX PDI-6221MG<br/>digital steering servo<br/>SERVO_CENTER=90"]:::act
    C104_BTS["0.1 µF<br/>(BTS logic VCC-GND)"]:::pass
    CMOT["3× 0.1 µF<br/>(motor EMI:<br/> term-term, term-case ×2)"]:::pass
  end

  VBATT -- "+VBAT → B+" --> BTS
  V5 -- "+5 V → VCC (logic)" --> BTS
  V5 --- C104_BTS
  ESP -- "GPIO 38 R_EN" --- BTS
  ESP -- "GPIO 39 L_EN" --- BTS
  ESP -- "GPIO 40 R_PWM (LEDC Ch0)" --- BTS
  ESP -- "GPIO 41 L_PWM (LEDC Ch1)" --- BTS
  BTS -- "M+ (red)" --> MOT
  BTS -- "M− (black)" --> MOT
  MOT --- CMOT

  V5 -- "+5 V (red)" --> SRV
  ESP -- "GPIO 42 PWM (orange · LEDC Ch2 · 50 Hz)" --- SRV

  %% ===== I²C0 BUS =====
  subgraph I2C0 ["4 · I²C0 — Wire (GPIO 8/9)"]
    direction TB
    IMU["ICM-20948<br/>0x68 (AD0=GND)<br/>+ AK09916 mag 0x0C aux"]:::sens
    ASL["AS5600 Left<br/>0x36 (factory)"]:::sens
    TFF["VL53L1X Front<br/>0x29 → 0x30 post-XSHUT"]:::sens
    PU0A["4.7 kΩ SDA → 3V3"]:::pass
    PU0B["4.7 kΩ SCL → 3V3"]:::pass
    C104_IMU["0.1 µF<br/>(IMU VCC-GND)"]:::pass
    C104_ASL["0.1 µF<br/>(AS5600 L VCC-GND)"]:::pass
    C104_TFF["0.1 µF<br/>(VL53L1X F VIN-GND)"]:::pass
  end

  ESP -- "+3.3 V (onboard LDO)" --> PU0A
  ESP -- "+3.3 V" --> PU0B
  ESP -- "+3.3 V → VCC" --- IMU
  ESP -- "+3.3 V → VCC" --- ASL
  V5  -- "+5 V → VIN" --- TFF
  ESP -- "GPIO 8 SDA" --- PU0A
  ESP -- "GPIO 9 SCL" --- PU0B
  PU0A --- IMU
  PU0A --- ASL
  PU0A --- TFF
  PU0B --- IMU
  PU0B --- ASL
  PU0B --- TFF
  ESP -- "GPIO 15 XSHUT (boot-LOW · then HIGH · then write 0x30)" --- TFF
  IMU --- C104_IMU
  ASL --- C104_ASL
  TFF --- C104_TFF

  %% ===== I²C1 BUS =====
  subgraph I2C1 ["5 · I²C1 — Wire1 (GPIO 11/12)"]
    direction TB
    ASR["AS5600 Right<br/>0x36 (factory)"]:::sens
    TFS["VL53L1X Side<br/>0x29 → 0x31 post-XSHUT"]:::sens
    PU1A["4.7 kΩ SDA → 3V3"]:::pass
    PU1B["4.7 kΩ SCL → 3V3"]:::pass
    C104_ASR["0.1 µF<br/>(AS5600 R VCC-GND)"]:::pass
    C104_TFS["0.1 µF<br/>(VL53L1X S VIN-GND)"]:::pass
  end

  ESP -- "+3.3 V" --> PU1A
  ESP -- "+3.3 V" --> PU1B
  ESP -- "+3.3 V → VCC" --- ASR
  V5  -- "+5 V → VIN" --- TFS
  ESP -- "GPIO 11 SDA" --- PU1A
  ESP -- "GPIO 12 SCL" --- PU1B
  PU1A --- ASR
  PU1A --- TFS
  PU1B --- ASR
  PU1B --- TFS
  ESP -- "GPIO 16 XSHUT (boot-LOW · then HIGH · then write 0x31)" --- TFS
  ASR --- C104_ASR
  TFS --- C104_TFS

  %% ===== STAR GROUND =====
  GND((("⭐<br/>STAR<br/>GND")))
  class GND star

  BATT -.->|"−"| GND
  V5 -.->|"GND"| GND
  BTS -.->|"B− and Logic GND"| GND
  ESP -.->|"GND"| GND
  OMV -.->|"GND"| GND
  SRV -.->|"GND (brown)"| GND
  ESTOP -.- GND
  LED -.->|"cathode"| GND
  IMU -.- GND
  ASL -.- GND
  ASR -.- GND
  TFF -.- GND
  TFS -.- GND
  MOT -.- GND
