%% WRO v13 — Focused view 2: Signal & control (no power, no I²C)
%% Covers: UART2 to camera, motor + servo PWM, safety/status I/O.
%% I²C is in 03_i2c_buses.mmd. Power is in 01_power_distribution.mmd.

flowchart LR

  classDef brain fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000
  classDef cam   fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#000
  classDef act   fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#000
  classDef io    fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
  classDef gpio  fill:#eceff1,stroke:#37474f,stroke-width:1px,color:#000

  %% ============ ESP32 GPIO BLOCK ============
  subgraph ESPBLK ["ESP32-S3-DevKitC-1 N8R8"]
    direction TB
    G17["GPIO 17 · UART2 RX"]:::gpio
    G18["GPIO 18 · UART2 TX"]:::gpio
    G38["GPIO 38 · R_EN"]:::gpio
    G39["GPIO 39 · L_EN"]:::gpio
    G40["GPIO 40 · R_PWM (LEDC Ch0)"]:::gpio
    G41["GPIO 41 · L_PWM (LEDC Ch1)"]:::gpio
    G42["GPIO 42 · servo PWM (Ch2 · 50 Hz)"]:::gpio
    G21["GPIO 21 · E-Stop INT (active LOW)"]:::gpio
    G2["GPIO 2 · Status LED"]:::gpio
    G48["GPIO 48 · Onboard WS2812"]:::gpio
  end
  class ESPBLK brain

  %% ============ CAMERA UART ============
  subgraph UART ["UART2 · 115200 8N1 · ASCII v3"]
    direction TB
    OMV["OpenMV H7 Plus<br/>main.py"]:::cam
    PAYLOAD["RedX,RedDist,GreenX,GreenDist,<br/>ModeFlag,ExtraTag*XX\\n"]
  end
  G17 <-- "RX ← TX" --- OMV
  G18 -- "TX → RX" --- OMV
  OMV --> PAYLOAD

  %% ============ MOTOR DRIVE ============
  subgraph DRIVE ["Drive (BTS7960)"]
    direction TB
    BTS["BTS7960<br/>43 A H-Bridge"]:::act
    MOT(["Motor 380"]):::act
  end
  G38 --> BTS
  G39 --> BTS
  G40 --> BTS
  G41 --> BTS
  BTS -->|M+ / M−| MOT

  %% ============ STEERING ============
  subgraph STEER ["Steering"]
    SRV["JX PDI-6221MG<br/>SERVO_CENTER=90<br/>LEFT=45 · RIGHT=135"]:::act
  end
  G42 -->|PWM 1000–2000 µs| SRV

  %% ============ SAFETY / STATUS ============
  subgraph SAFE ["Safety &amp; status"]
    direction TB
    ESTOP["E-STOP button<br/>(N.O., INPUT_PULLUP)"]:::io
    LED["Status LED + 220 Ω"]:::io
    RGB["Onboard WS2812"]:::io
  end
  G21 --- ESTOP
  G2 --> LED
  G48 --> RGB
