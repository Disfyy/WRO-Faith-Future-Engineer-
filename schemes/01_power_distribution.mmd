%% WRO v13 — Focused view 1: Power distribution
%% Shows ONLY power routing (VBAT / 5 V / 3.3 V) + decoupling + star ground.
%% Companion files: 02_signal_control, 03_i2c_buses, 04_fsm_dataflow.

flowchart LR

  classDef pwr5  fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000
  classDef pwr3  fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
  classDef sw    fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000
  classDef load  fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
  classDef cap   fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#000
  classDef star  fill:#212121,color:#ffeb3b,stroke:#ffeb3b,stroke-width:4px

  %% ============ SOURCE ============
  BATT["LiPo 2S 7.4 V<br/>or 3S 11.1 V"]:::pwr5
  SW["KCD3 main switch<br/>(SPST · &gt;5 A)"]:::sw
  VBATT(["+VBAT bus"]):::pwr5
  CAP470["470 µF<br/>(VBAT bulk)"]:::cap
  BUCK["LM2596 / D-SUN buck<br/>Vin → +5 V · 3 A"]:::pwr5
  V5(["+5 V rail"]):::pwr5
  CAP104A["0.1 µF<br/>(V5 decouple)"]:::cap
  V33(["+3.3 V rail<br/>ESP32-S3 onboard LDO"]):::pwr3

  BATT -->|"+ red"| SW
  SW --> VBATT
  VBATT --- CAP470
  VBATT --> BUCK
  BUCK --> V5
  V5 --- CAP104A
  V5 -. "ESP32-S3 VIN→LDO" .-> V33

  %% ============ +5 V LOADS ============
  subgraph L5 ["+5 V loads"]
    direction TB
    ESP5["ESP32-S3 VIN"]:::load
    OMV5["OpenMV H7+ VIN"]:::load
    SRV5["JX PDI-6221MG<br/>(high stall current)"]:::load
    TFF5["VL53L1X Front VIN"]:::load
    TFS5["VL53L1X Side VIN"]:::load
    BTSL["BTS7960 logic VCC"]:::load
  end

  %% ============ +3.3 V LOADS ============
  subgraph L33 ["+3.3 V loads"]
    direction TB
    IMU33["ICM-20948"]:::load
    ASL33["AS5600 Left"]:::load
    ASR33["AS5600 Right"]:::load
    PU0["4.7 kΩ pull-ups · I²C0"]:::load
    PU1["4.7 kΩ pull-ups · I²C1"]:::load
  end

  %% ============ +VBAT DIRECT LOADS ============
  subgraph LVBAT ["Direct motor power"]
    direction TB
    BTSP["BTS7960 B+ (battery in)"]:::load
    MOT["Motor 380<br/>+ 3× 0.1 µF EMI caps"]:::load
  end

  V5 ==> ESP5
  V5 ==> OMV5
  V5 ==> SRV5
  V5 ==> TFF5
  V5 ==> TFS5
  V5 ==> BTSL

  V33 --> IMU33
  V33 --> ASL33
  V33 --> ASR33
  V33 --> PU0
  V33 --> PU1

  VBATT ==> BTSP
  BTSP --> MOT

  %% ============ STAR GROUND ============
  GND((("⭐ STAR GND"))):::star

  BATT -.->|−| GND
  V5 -.- GND
  V33 -.- GND
  ESP5 -.- GND
  OMV5 -.- GND
  BTSL -.- GND
  BTSP -.- GND
  SRV5 -.- GND
  IMU33 -.- GND
  ASL33 -.- GND
  ASR33 -.- GND
  TFF5 -.- GND
  TFS5 -.- GND
  MOT -.- GND
