flowchart LR

  classDef power fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000;
  classDef gnd fill:#e0e0e0,stroke:#37474f,stroke-width:2px,color:#000;
  classDef signal fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000;
  classDef sensor fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000;
  classDef brains fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#000;
  classDef star fill:#000000,color:#ffffff,shape:circle,stroke-width:4px,stroke:#ffeb3b;

  subgraph PWR [1. Power Supply]
    direction TB
    BATT[LiPo 2S/3S]:::power
    SW[KCD3 Main Switch]:::power
    V5[+5V Rail]:::power
    C470[470uF on 5V]:::power
    C104_5[0.1uF 5V]:::power
    BATT -- "+VBAT (Red)" --> SW
    SW -- "+VBAT" --> V5
    V5 --- C470
    V5 --- C104_5
  end

  subgraph BRAIN [2. Controllers]
    direction TB
    ESP[ESP32-S3-DevKitC-1 N8R8]:::brains
    OMV[OpenMV H7 Plus]:::brains
    ESTOP[E-STOP Button GPIO21]:::signal
    LED[Status LED + 220R GPIO2]:::signal
    RGB[Onboard WS2812 GPIO48]:::signal
  end

  subgraph DRIVE [3. Motor and Servo]
    direction TB
    BTS[BTS7960 Motor Driver]:::signal
    MOT[Motor 380]:::power
    SRV[JX PDI-6221MG Servo GPIO42]:::signal
    C104_BTS[0.1uF VCC-GND]:::gnd
    CM[3x 0.1uF Motor EMI]:::gnd
  end

  subgraph I2CBUS [4. I2C - IMU only]
    direction TB
    IMU[ICM-20948 0x68]:::sensor
    PULLUP[4.7k Pull-ups]:::gnd
  end

  subgraph SPIBUS [5. SPI HSPI - 2x AS5048A 14-bit]
    direction TB
    ASL[AS5048A Left  CS=GPIO10]:::sensor
    ASR[AS5048A Right CS=GPIO14]:::sensor
  end

  subgraph UARTBLK [6. UART distance + camera]
    direction TB
    TFF[TFMini-S Front UART1 12m]:::sensor
    TFS[TFMini-S Side UART SW GPIO47 optional]:::sensor
  end

  %% Power Routing
  V5 -- "+5V -> VIN" --> ESP
  V5 -- "+5V -> VIN" --> OMV
  V5 -- "+5V (Red)" --> SRV
  V5 -- "+5V -> VCC" --> BTS
  V5 -- "+5V REQUIRED" --> TFF
  SW -- "+VBAT -> B+" --> BTS

  ESP -- "+3.3V onboard reg" --> PULLUP
  ESP -- "+3.3V -> VCC" --> IMU
  ESP -- "+3.3V -> VCC" --> ASL
  ESP -- "+3.3V -> VCC" --> ASR

  %% Signal Routing
  ESP -- "GPIO17 (RX) <- TX" --> OMV
  ESP -- "GPIO18 (TX) -> RX" --> OMV
  ESP -- "GPIO21" --> ESTOP
  ESP -- "GPIO2" --> LED
  ESP -- "GPIO48" --> RGB

  ESP -- "GPIO38 R_EN, GPIO39 L_EN, GPIO40 RPWM, GPIO41 LPWM" --> BTS
  BTS -- "M+, M-" --> MOT
  MOT -. "EMI" .- CM
  BTS -. "Logic Filter" .- C104_BTS
  ESP -- "GPIO42 PWM" --> SRV

  ESP -- "GPIO8 SDA, GPIO9 SCL" --> PULLUP
  PULLUP -- "SDA, SCL" --> IMU

  ESP -- "HSPI: GPIO11 MOSI tied 3V3, GPIO12 SCK, GPIO13 MISO" --> ASL
  ESP -- "HSPI shared bus" --> ASR

  ESP -- "UART1: GPIO15 RX, GPIO16 TX (115200)" --> TFF
  ESP -. "UART SW: GPIO47 RX (optional)" .-> TFS

  %% STAR GROUND ROUTING
  STAR_GND(((STAR GND\nCenter Point))):::star

  BATT -- "GND (-) (Black)" --> STAR_GND
  STAR_GND -- "GND" --> V5
  STAR_GND -- "GND -> B-, Logic GND" --> BTS
  STAR_GND -- "GND (Brown)" --> SRV
  STAR_GND -- "GND" --> ESP
  STAR_GND -- "GND" --> OMV
  STAR_GND -- "Cathode" --> LED
  STAR_GND -- "GND" --> ESTOP
  STAR_GND -- "GND" --> IMU
  STAR_GND -- "GND" --> ASL
  STAR_GND -- "GND" --> ASR
  STAR_GND -- "GND" --> TFF
